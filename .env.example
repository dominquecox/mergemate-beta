# Names only, never real values. Full list of the project's variables.
# Worker (API) values go in apps/api/.dev.vars locally (git-ignored) and `wrangler secret put` when deployed.
# The mobile/web app's only local file is apps/mobile/.env with EXPO_PUBLIC_API_BASE_URL. No secrets in the app.

# --- Worker (apps/api) ---
MODEL_PROVIDER=
MODEL_ID=
MODEL_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=
SESSION_SIGNING_KEY=
# Email (Resend sends from the product address on the verified company domain)
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
# Turnstile: the secret is server-side only
TURNSTILE_SECRET_KEY=
# Payments (Stripe, web only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# --- Mobile (apps/mobile): public, non-secret values only (EXPO_PUBLIC_ is bundled into the app) ---
EXPO_PUBLIC_API_BASE_URL=

# --- Web (admin and public pages): the Turnstile site key is public by design ---
TURNSTILE_SITE_KEY=
