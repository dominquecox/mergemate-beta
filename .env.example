# Names only. Copy to .env locally (git-ignored); never put real values here.
# Server-side secrets live in the Worker (wrangler secret / .dev.vars), never in the mobile app.

# --- Worker (apps/api) ---
MODEL_PROVIDER=
MODEL_ID=
MODEL_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SIGNING_KEY=

# --- Mobile (apps/mobile): public, non-secret values only (EXPO_PUBLIC_ is bundled into the app) ---
EXPO_PUBLIC_API_BASE_URL=
