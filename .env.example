# Names only, never real values.
# API (Worker) names are listed in apps/api/.dev.vars.example (local, git-ignored .dev.vars)
# and apps/api/DEPLOY.md (deployed secrets). No secrets in the app.

# --- Mobile (apps/mobile): public, non-secret values only (EXPO_PUBLIC_ is bundled into the app) ---
EXPO_PUBLIC_API_BASE_URL=

# --- Web (public pages): the Turnstile site key is public by design ---
TURNSTILE_SITE_KEY=
