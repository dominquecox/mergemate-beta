# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app, so never put a secret here.

# Where the app talks to. Pick one:
#   local        http://localhost:8787            (npm run dev -w @mergemate/api)
#   development  https://api-dev.mergemate.dev
#   production   https://api.mergemate.dev
# Unset in a development build: the app shows built-in sample data and a "Sample data" banner.
# Unset or invalid in a production build: the app refuses to start.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# Public Cloudflare Turnstile site key for the demo and the support form (web only).
# For local use Cloudflare's always-pass test key and the matching test secret in the API's .dev.vars.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
