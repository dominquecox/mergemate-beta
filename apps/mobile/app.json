{
  "expo": {
    "name": "MergeMate",
    "slug": "mergemate",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mergemate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mergemate.app",
      "associatedDomains": [
        "applinks:app.mergemate.dev",
        "applinks:dev.mergemate.dev"
      ]
    },
    "android": {
      "package": "dev.mergemate.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B12"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.mergemate.dev",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "dev.mergemate.dev",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#4F46E5",
          "defaultChannel": "reviews-and-mentions"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MergeMate reads the screenshot you choose to explain it. It is not stored.",
          "cameraPermission": "MergeMate uses the camera only when you take a photo to explain."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
