{
  "expo": {
    "name": "MergeMate",
    "slug": "mergemate",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mergemate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.mergemate.app",
      "associatedDomains": [
        "applinks:app.mergemate.dev",
        "applinks:dev.mergemate.dev"
      ]
    },
    "android": {
      "package": "dev.mergemate.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B12"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "MergeMate reads the screenshot you choose to explain it. It is not stored.",
          "cameraPermission": "MergeMate uses the camera only when you take a photo to explain."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
