# Names only. Copy to .dev.vars (git-ignored) for `wrangler dev`. Deployed values: `wrangler secret put <NAME>`.
# Secrets (never commit values)
MODEL_API_KEY=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SESSION_SIGNING_KEY=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
# Non-secret config (also fine as wrangler.toml [vars])
MODEL_PROVIDER=
MODEL_ID=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
EMAIL_FROM=
SUPPORT_EMAIL=
TURNSTILE_SITE_KEY=
