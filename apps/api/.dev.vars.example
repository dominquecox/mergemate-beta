# Names only. Copy to .dev.vars (git-ignored) for `wrangler dev`. Deployed values: see DEPLOY.md.
# Secrets (never commit values)
MODEL_API_KEY=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Only while rotating: the new webhook secret, accepted alongside the current one.
GITHUB_WEBHOOK_SECRET_NEXT=
# Format <version>:<base64 of 32 random bytes>, e.g. version 1. Generate the key with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Only while rotating: the previous TOKEN_ENCRYPTION_KEY, kept for decryption.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
# Support mail addresses (not secret, but kept out of the repo)
EMAIL_FROM=
SUPPORT_EMAIL=
# Non-secret config. APP_ENV, WEB_ORIGIN, SITE_ORIGIN, GITHUB_APP_CLIENT_ID, GITHUB_APP_SLUG and the model settings
# are in wrangler.toml [vars]; uncomment only to override locally (an empty value also overrides).
# STRIPE_MODE=
# APP_ENV=
# WEB_ORIGIN=
# SITE_ORIGIN=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_SLUG=
# MODEL_ROUTE_SUMMARY=
# MODEL_ROUTE_RISK=
# MODEL_ROUTE_TRIAGE=
# MODEL_ROUTE_HIGHLIGHT=
# MODEL_BASE_URL=
# Optional, not a secret: the AI Gateway id for Workers AI calls. Leave unset to call without a gateway.
# AI_GATEWAY_ID=
GITHUB_APP_ID=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
TURNSTILE_SITE_KEY=
