    "lint": "eslint .",
    "test": "vitest run",
    "check:env": "node scripts/check-env.mjs",
    "check:dev-ai": "node scripts/check-dev-ai.mjs"
  },
  "dependencies": {
    "@mergemate/contracts": "*",
