{
  "name": "@mergemate/brain-mcp",
  "private": true,
  "version": "0.0.0",
  "description": "MCP server + client for MergeMate brain track (MM-119): 7 tools over the merged MM-115 agent API.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js",
    "test": "npm run build && vitest run",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@mergemate/contracts": "*",
    "zod": "4.6.7"
  }
}
